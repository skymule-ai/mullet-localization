ROS_DOMAIN_ID=99

# Which stack runs on `docker compose up -d`. openvins = realsense + OpenVINS + ev_bridge.
# Add livox once the Mid-360S is wired, foxglove for the ground-station view.
COMPOSE_PROFILES=openvins

# Image tags from mullet-drivers, mullet-vio and this repo. On an aircraft use immutable tags
# (sha-<commit> or vX.Y.Z), never main.
DRIVERS_TAG=v0.4.0
VIO_TAG=v0.2.0
LOCALIZATION_TAG=v0.1.0

# The running estimator's nav_msgs/Odometry (OpenVINS: /uav0/openvins/odomimu).
ODOMETRY_TOPIC=/uav0/openvins/odomimu
# false: shadow mode, odometry goes to /localization/vehicle_odometry only.
# true: px4_ev_bridge publishes /fmu/in/vehicle_visual_odometry (PX4 fuses it per EKF2_EV_CTRL).
PUBLISH_TO_PX4=false
