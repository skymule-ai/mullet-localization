# ROS_DOMAIN_ID and LIVOX_IFACE are not set here: they come from /etc/mullet/drone.env (mullet-setup),
# shared by every Compose project on the drone.

# Which stack runs on `docker compose up -d`. openvins = realsense + OpenVINS + ev_bridge;
# fast-lio = livox + livox-ptp + FAST-LIO2 + ev_bridge. openvins,fast-lio runs both (comparison
# flights; the bridge forwards ODOMETRY_TOPIC only). Add foxglove for the ground-station view.
COMPOSE_PROFILES=openvins

# Image tags from mullet-drivers, mullet-vio, mullet-lio and this repo. On an aircraft use immutable tags
# (sha-<commit> or vX.Y.Z), never main.
DRIVERS_TAG=sha-8d0563c
VIO_TAG=v0.2.0
LIO_TAG=sha-7b28b1b
LOCALIZATION_TAG=sha-4f7c336

# The estimator the bridge forwards, and its body-to-base_link extrinsic:
#   OpenVINS:  /uav0/openvins/odomimu   ev_bridge.yaml
#   FAST-LIO2: /uav0/fast_lio/odometry  ev_bridge_fast_lio.yaml
ODOMETRY_TOPIC=/uav0/openvins/odomimu
EV_BRIDGE_CONFIG=ev_bridge.yaml

# false: shadow mode, odometry goes to /localization/vehicle_odometry only.
# true: px4_ev_bridge publishes /fmu/in/vehicle_visual_odometry (PX4 fuses it per EKF2_EV_CTRL).
PUBLISH_TO_PX4=false
